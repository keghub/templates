<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
		<LangVersion>latest</LangVersion>
		<RootNamespace>EMG</RootNamespace>
		<AssemblyName>EMG.BatchJobProcessor</AssemblyName>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<!--#if (ConfigureAWS)-->
		<PackageReference Include="AWSSDK.Core" Version="4.0.102.11" />
		<PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.102.4" />
		<!--#endif-->
		<!--#if (AddLoggly)-->
		<PackageReference Include="EMG.Extensions.Logging.Loggly" Version="1.6.0" />
		<!--#endif-->

		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.13" />

		<PackageReference Include="AWS.Logger.AspNetCore" Version="4.0.2" />

		<PackageReference Include="McMaster.Extensions.CommandLineUtils" Version="5.1.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="appsettings.*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="hostsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
