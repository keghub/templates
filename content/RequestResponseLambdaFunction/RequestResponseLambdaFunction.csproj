<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
		<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
		<AWSProjectType>Lambda</AWSProjectType>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<RootNamespace>EMG</RootNamespace>
		<AssemblyName>EMG.RequestResponseLambdaFunction</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Amazon.Lambda.Logging.AspNetCore" Version="5.1.0" />
		<!--#if (ConfigureAWS)-->
		<PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.102.4" />
		<!--#endif-->
		<!--#if (AddLoggly)-->
		<PackageReference Include="EMG.Extensions.Logging.Loggly" Version="1.6.0" />
		<!--#endif-->
		<PackageReference Include="Amazon.Lambda.Core" Version="3.4.0" />
		<PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
